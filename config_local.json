{
  "gateway": {
    "serial_number": "12345678"
  },
  "mqtt": {
    "host": "127.0.0.1",
    "port": 1883,
    "topic": "v1/gateway/12345678/telemetry",
    "username": "",
    "password": "",
    "qos": 1,
    "client_id": "novena-gateway-12345678",
    "max_queue_size": 100000,
    "reconnect_delay_min": 1,
    "reconnect_delay_max": 60
  },
  "storage": {
    "sqlite": {
      "data_file_path": "storage/sqlite/",
      "max_read_records_count": 50,
      "writing_batch_size": 50
    },
    "update_path": "storage/update",
    "ota_status_path": "storage/update/ota_status.json"
  },
  "logging": {
    "file": "./novena-gateway.log",
    "max_bytes": 5242880,
    "backup_count": 5
  },
  "features": {
    "remote_logging": {
      "enabled": true,
      "min_level": "INFO",
      "batch_size": 20,
      "flush_interval_seconds": 5,
      "max_buffer_size": 500
    },
    "attribute_sync": {
      "enabled": true,
      "heartbeat_interval_seconds": 60
    },
    "connectivity_health": {
      "enabled": true,
      "interval_seconds": 120,
      "timeout_seconds": 5
    },
    "remote_config": {
      "enabled": true,
      "backup_dir": "config_backups",
      "last_known_good_path": "last_known_good_config.json"
    },
    "rpc": {
      "enabled": true,
      "local_writeback_enabled": false,
      "trusted_clock": false,
      "max_clock_offset_seconds": 5,
      "trusted_command_keys": {},
      "revoked_command_key_ids": [],
      "command_policy_path": "storage/remote_control/policy.json",
      "command_journal_path": "storage/remote_control/command_journal.json"
    }
  },
  "connectors": [
    {
      "type": "modbus",
      "name": "Modbus TCP Connector",
      "config": {
        "logLevel": "DEBUG",
        "master": {
          "slaves": [
            {
              "host": "127.0.0.1",
              "port": 5020,
              "type": "tcp",
              "method": "socket",
              "timeout": 35,
              "byteOrder": "BIG",
              "wordOrder": "BIG",
              "retries": true,
              "retryOnEmpty": true,
              "retryOnInvalid": true,
              "pollPeriod": 5000,
              "unitId": 1,
              "deviceName": "Power meter 1",
              "sendDataOnlyOnChange": false,
              "connectAttemptTimeMs": 5000,
              "connectAttemptCount": 5,
              "waitAfterFailedAttemptsMs": 300000,
              "timeseries": [
                {
                  "tag": "voltage",
                  "type": "16int",
                  "functionCode": 3,
                  "objectsCount": 1,
                  "address": 0,
                  "multiplier": 0.1
                },
                {
                  "tag": "active_power",
                  "type": "16int",
                  "functionCode": 3,
                  "objectsCount": 1,
                  "address": 1,
                  "multiplier": 0.1
                }
              ],
              "attributes": []
            }
          ]
        }
      }
    }
  ]
}
