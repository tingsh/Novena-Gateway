#!/usr/bin/env bash
# Narrow privileged helper for Novena Gateway service user.

set -euo pipefail

action="${1:-}"

valid_iface() {
    [[ "$1" =~ ^[A-Za-z0-9_.:-]+$ ]]
}

valid_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

case "$action" in
    reboot)
        delay="${2:-5}"
        valid_int "$delay"
        nohup sh -c "sleep '$delay' && /sbin/reboot" >/dev/null 2>&1 &
        echo "reboot scheduled"
        ;;
    restart-service)
        service="${2:-novena-gateway}"
        [[ "$service" == "novena-gateway" ]]
        systemctl restart "$service"
        echo "service restarted"
        ;;
    set-route-metric)
        iface="${2:?interface required}"
        profile_uuid="${3:?active profile UUID required}"
        metric="${4:?metric required}"
        valid_iface "$iface"
        [[ "$profile_uuid" =~ ^[0-9a-fA-F-]{36}$ ]]
        [[ "$metric" =~ ^(-1|[0-9]+)$ ]]
        [[ "$(nmcli -g GENERAL.CON-UUID device show "$iface")" == "$profile_uuid" ]]
        # Change only the active device. Never reactivate it or persist a profile edit.
        nmcli device modify "$iface" ipv4.route-metric "$metric"
        echo "temporary route metric updated"
        ;;
    configure-can)
        iface="${2:-can0}"
        bitrate="${3:-500000}"
        valid_iface "$iface"
        valid_int "$bitrate"
        ip link set "$iface" down || true
        ip link set "$iface" type can bitrate "$bitrate"
        ip link set "$iface" up
        echo "can configured"
        ;;
    run-upgrade)
        payload="${2:?payload tar required}"
        version="${3:?version required}"
        manifest="${4:?manifest required}"
        script_real="/opt/novena-gateway/current/install/upgrade.sh"
        payload_real="$(readlink -f "$payload")"
        manifest_real="$(readlink -f "$manifest")"
        [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(rc|canary)\.[0-9]+)?$ ]]
        [[ "$payload_real" == /var/lib/novena-gateway/update/* ]]
        [[ "$manifest_real" == /var/lib/novena-gateway/update/* ]]
        [[ -f "$script_real" ]]
        nohup /bin/bash "$script_real" "$payload_real" "$version" "$manifest_real" >/var/log/novena-gateway/ota-upgrade.log 2>&1 &
        echo "upgrade started"
        ;;
    *)
        echo "Unknown or missing action: $action" >&2
        exit 64
        ;;
esac
